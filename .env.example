# Copie para .env e troque os valores. NUNCA suba o .env para o git.

# Banco (usado pelo docker-compose)
POSTGRES_USER=gigi
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=gigi

# API
# Desenvolvimento sem Docker: banco embutido salvo na pasta apps/api/.data
DATABASE_URL=pglite:./.data/dev
# Com Docker (docker compose up -d db), use:
# DATABASE_URL=postgres://gigi:troque-esta-senha@localhost:5432/gigi
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
CORS_ORIGIN=http://localhost:5173
# true em produção (exige HTTPS)
COOKIE_SECURE=false
PORT=3333

# Usuário admin criado pelo "npm run db:seed -w apps/api"
SEED_ADMIN_EMAIL=admin@restaurantegigi.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha-de-admin
